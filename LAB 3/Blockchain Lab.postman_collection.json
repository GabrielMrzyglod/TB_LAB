  "item": [
    {
      "name": "Post mine",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();\r\n\r\npm.test(\"Status 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Skrót bloku spełnia warunek trudności (0000)\", function () {\r\n    pm.expect(json.hash.startsWith(\"0000\")).to.be.true;\r\n});\r\n\r\npm.test(\"Pierwsza transakcja to nagroda (coinbase)\", function () {\r\n    const tx = json.block.transactions[0];\r\n    pm.expect(tx.sender).to.eql(\"0\");\r\n    pm.expect(tx.amount).to.eql(1);\r\n});\r\n\r\nconst prevHash = pm.environment.get(\"lastHash\");\r\nif (prevHash) {\r\n    pm.test(\"previous_hash zgadza się z lastHash poprzedniego bloku\", function () {\r\n        pm.expect(json.block.previous_hash).to.eql(prevHash);\r\n    });\r\n}\r\n\r\npm.environment.set(\"prevBlockHash\", json.block.previous_hash);\r\npm.environment.set(\"lastHash\", json.hash);\r\npm.environment.set(\"nodeId\", json.block.transactions[0].recipient);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/mine",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "mine"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Post transactions new",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();\r\n\r\npm.test(\"Status 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Odpowiedź zawiera komunikat z numerem bloku\", function () {\r\n    pm.expect(json).to.have.property(\"message\");\r\n    pm.expect(json.message).to.include(\"Transakcja zostanie dodana do bloku\");\r\n});"
            ]
          }
        }
      ],
