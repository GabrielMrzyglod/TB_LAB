      "name": "Get chain",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();\r\n\r\npm.test(\"Status 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Długość łańcucha zgodna z polem length\", function () {\r\n    pm.expect(json.chain.length).to.eql(json.length);\r\n});\r\n\r\nconst expectedPrevHash = pm.environment.get(\"prevBlockHash\");\r\nif (expectedPrevHash && json.chain.length > 1) {\r\n    pm.test(\"Ostatni blok ma poprawny previous_hash\", function () {\r\n        const lastBlock = json.chain[json.chain.length - 1];\r\n        pm.expect(lastBlock.previous_hash).to.eql(expectedPrevHash);\r\n    });\r\n}"
            ]
          }
        }
      ],
